PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/ai_immigration_crm_db
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5000
MAX_UPLOAD_SIZE=10485760
SEED_DEMO_DATA=false
INITIAL_ADMIN_NAME=Nestway Admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace_with_a_strong_admin_password

# Meta & Social Ads Webhook Configuration
META_VERIFY_TOKEN=replace_with_your_webhook_verify_token
META_APP_SECRET=your_meta_app_secret_here
META_ACCESS_TOKEN=your_meta_system_user_access_token_here
META_PAGE_ID=your_meta_page_id_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# AI Engine Configuration (gemini, openai, or built-in)
AI_PROVIDER=built-in
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
